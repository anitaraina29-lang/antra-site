{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/payment-success", "destination": "/api/payment-success" },
    { "source": "/payment-failure", "destination": "/api/payment-failure" }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] }
  ]
}
