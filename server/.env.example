# ==========================================================
#  ANTRA — Pay4U configuration
#  1. Copy this file to ".env"   (cp .env.example .env)
#  2. Fill in the values from your Pay4U dashboard
#  3. NEVER commit or share the real .env file
# ==========================================================

# Your API Key (from Pay4U "API Key Salt details" -> NAME "key")
PAY4U_KEY=your_key_here

# Your Salt  (use the salt Pay4U's docs tell you to use for hashing.
#             Most gateways use the 32-bit salt. Confirm with Pay4U.)
PAY4U_SALT=your_salt_here

# The payment URL Pay4U gives you in their integration docs.
# TEST/sandbox first, switch to live only after testing works.
# (This is a placeholder — replace with the exact URL from Pay4U docs.)
PAY4U_ENDPOINT=https://test.pay4u.example/_payment

# Where Pay4U should send the customer after payment
# (these point back to this server while testing on localhost)
SUCCESS_URL=http://localhost:8787/payment-success
FAILURE_URL=http://localhost:8787/payment-failure

# Port this backend runs on
PORT=8787
